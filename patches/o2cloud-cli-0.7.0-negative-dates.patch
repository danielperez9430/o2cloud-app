+/// Timestamps are Unix milliseconds. Some very old items (videos imported
+/// from old phones) carry negative values; treat those as "unknown" rather
+/// than failing the entire listing.
+fn deserialize_optional_timestamp<'de, D>(deserializer: D) -> Result<Option<u64>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    use serde::de;
+    struct TimestampVisitor;
+    impl de::Visitor<'_> for TimestampVisitor {
+        type Value = Option<u64>;
+        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+            f.write_str("a non-negative timestamp in milliseconds, or null")
+        }
+        fn visit_u64<E: de::Error>(self, v: u64) -> Result<Option<u64>, E> {
+            Ok(Some(v))
+        }
+        fn visit_i64<E: de::Error>(self, v: i64) -> Result<Option<u64>, E> {
+            Ok(if v < 0 { None } else { Some(v as u64) })
+        }
+        fn visit_str<E: de::Error>(self, v: &str) -> Result<Option<u64>, E> {
+            match v.parse::<i64>() {
+                Ok(n) if n >= 0 => Ok(Some(n as u64)),
+                Ok(_) => Ok(None),
+                Err(_) => Err(de::Error::custom("invalid timestamp")),
+            }
+        }
+        fn visit_none<E: de::Error>(self) -> Result<Option<u64>, E> {
+            Ok(None)
+        }
+        fn visit_unit<E: de::Error>(self) -> Result<Option<u64>, E> {
+            Ok(None)
+        }
+    }
+    deserializer.deserialize_any(TimestampVisitor)
+}
